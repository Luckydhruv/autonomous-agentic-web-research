# ─────────────────────────────────────────────
# Autonomous Agentic Web Research System
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite:///./research.db
# For PostgreSQL: postgresql://user:password@localhost:5432/research_db

# ── Local Crawl4AI Python API (required for crawling) ──
CRAWL4AI_API_BASE=http://localhost:11235
CRAWL4AI_API_TOKEN=generate_a_long_random_token

# ── Ollama (optional local LLM) ───────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Set to false to use deterministic extraction/planning
OLLAMA_ENABLED=true

# ── Optional Cloud LLM (OpenAI-compatible) ────
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=your_api_key_here
CLOUD_LLM_MODEL=gpt-4o-mini

# ── Crawl Defaults ────────────────────────────
DEFAULT_MAX_PAGES=20
DEFAULT_CRAWL_DEPTH=2

# ── Local BART page summaries (auto prefers the fine-tuned repo-root checkpoint) ──
BART_ENABLED=true
BART_MODEL=auto
BART_INPUT_TOKENS=900
BART_SUMMARY_TOKENS=100
